<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules. Mirrors backup_rules.xml intent:
    preferences are backed up; session photo cache is excluded implicitly
    (Android never backs up cache directories).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>